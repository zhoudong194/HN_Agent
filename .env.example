# =============================================================
# HN_Agent - Environment Configuration Template
# =============================================================
#
# HOW TO USE:
#   1. Copy this file to `.env`
#        copy .env.example .env      # Windows
#
#   2. Fill in your values.
#
#   3. NEVER commit the real `.env` to git.
#
# =============================================================

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000

# ---------- LLM (OpenAI-compatible) ----------
# Required for AI-style answers. Leave empty to fall back to
# retrieval-only mode (returns raw passages).
OPENAI_API_KEY=sk-your-api-key-here

OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ---------- Embedding model ----------
# BAAI/bge-large-zh-v1.5 — 中文优化的 Embedding 模型 (~330 MB)
EMBED_MODEL_NAME=BAAI/bge-large-zh-v1.5
EMBED_DIM=1024

# Optional. HuggingFace token for faster model downloads
# Get one at: https://huggingface.co/settings/tokens
HF_TOKEN=

# ---------- Vector store (FAISS) ----------
# FAISS HNSW 索引持久化目录
FAISS_DIR=./faiss_index

# 每个 chunk 的向量二进制文件存储目录
EMBEDDINGS_DIR=./embeddings

# ---------- Metadata store (SQLite) ----------
# SQLite 元数据库路径（documents + chunks 元数据）
META_DB_PATH=./rag_meta.db

# ---------- PostgreSQL + pgvector (primary) ----------
# Docker pgvector 容器，端口 5433
# Navicat 连接时主机=localhost，端口=5433
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ragdb
DB_USER=raguser
DB_PASSWORD=ragpass

# ---------- RAG retrieval ----------
TOP_K=5
SIMILARITY_THRESHOLD=0.0

# ---------- Data directory ----------
DATA_DIR=./data
