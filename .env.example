# =============================================================
# HN_Agent - Environment Configuration Template
# =============================================================
#
# HOW TO USE:
#   1. Copy this file to `.env`  (the dotfile is git-ignored)
#        cp .env.example .env        # macOS / Linux
#        copy .env.example .env      # Windows
#
#   2. Fill in your own values. Anything left blank will fall
#      back to the defaults defined in `config.py`.
#
#   3. NEVER commit the real `.env` to git. It contains secrets.
#      Only commit this `.env.example` (with placeholders).
#
# =============================================================


# ---------- Server ----------
HOST=0.0.0.0
PORT=8000


# ---------- LLM (OpenAI-compatible) ----------
# Required for the AI-style answer. Leave OPENAI_API_KEY empty
# to fall back to retrieval-only mode (returns raw passages).
OPENAI_API_KEY=sk-96c0a475965841fd9b6b95276e5b68ba

# 阿里云通义千问（推荐，中文强，性价比高）
# 更换供应商时只需修改 BASE 和 MODEL
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024


# ---------- Embedding model ----------
# The default (BAAI/bge-large-zh-v1.5) is the strongest open-source
# Chinese embedder and downloads ~1.5 GB on first run.
EMBED_MODEL_NAME=BAAI/bge-large-zh-v1.5
EMBED_DIM=1024

# Optional. Free token from https://huggingface.co/settings/tokens
# Helps avoid rate limits / download failures in some regions.
HF_TOKEN=


# ---------- Vector store (ChromaDB) ----------
CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=rules_vectors


# ---------- RAG retrieval ----------
TOP_K=5
# 0.0 = no cutoff (recommended for demos).
# 0.3 = only return reasonably relevant chunks.
SIMILARITY_THRESHOLD=0.0


# ---------- Data directory ----------
DATA_DIR=./data