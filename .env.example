# =============================================================
# HN_Agent - Environment Configuration Template
# =============================================================
#
# Local use:
#   copy .env.example .env
#
# Docker use:
#   docker compose --env-file .env up --build
#
# Never commit the real .env.
# =============================================================

# ---------- Server ----------
HOST=0.0.0.0
PORT=8000
APP_PORT=8000

# ---------- LLM (OpenAI-compatible) ----------
# Leave OPENAI_API_KEY empty to run retrieval-only mode.
OPENAI_API_KEY=
OPENAI_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ---------- Embedding model ----------
EMBED_MODEL_NAME=BAAI/bge-large-zh-v1.5
EMBED_DIM=1024
HF_TOKEN=

# ---------- PostgreSQL + pgvector ----------
# Local Python process connects to DB_HOST:DB_PORT.
# Docker Compose exposes PostgreSQL on localhost:DB_HOST_PORT
# and the API container connects internally to postgres:5432.
DB_HOST=localhost
DB_PORT=5433
DB_HOST_PORT=5433
DB_NAME=ragdb
DB_USER=raguser
DB_PASSWORD=ragpass

# ---------- RAG retrieval ----------
TOP_K=5
SIMILARITY_THRESHOLD=0.0

# ---------- Data directory ----------
DATA_DIR=./data

# ---------- Docker startup ----------
# 0: start API only; upload documents later from UI/API
# 1: ingest files mounted in ./data during container startup
AUTO_INGEST=0

# ---------- Auth / RBAC ----------
# Change this before exposing the service to other machines.
JWT_SECRET=change-me-in-production
JWT_TTL_HOURS=8
